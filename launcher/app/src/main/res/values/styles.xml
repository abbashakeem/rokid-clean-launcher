<resources>
    <style name="Theme.Hud" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/hud_black</item>
        <item name="android:colorBackground">@color/hud_black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/hud_black</item>
        <item name="android:navigationBarColor">@color/hud_black</item>
        <item name="android:textColor">@color/hud_white</item>
    </style>

    <!-- Base: white with a soft shadow for readability against the real world -->
    <style name="HudText">
        <item name="android:textColor">@color/hud_white</item>
        <item name="android:shadowColor">@color/hud_shadow</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <!-- Date strip: "SAT 12 SEP" left, city right -->
    <style name="HudText.Strip">
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/hud_dim</item>
    </style>

    <style name="HudText.Clock">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">52sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>
    <style name="HudText.AmPm">
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="HudText.Temp">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>
    <style name="HudText.Condition">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="HudText.Feels">
        <item name="android:textSize">10.5sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/hud_dim</item>
    </style>

    <!-- Agenda rows -->
    <style name="HudText.EventWhen">
        <item name="android:fontFamily">@font/ibmplexmono_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/hud_dim</item>
    </style>
    <style name="HudText.EventTitle">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Kept for the picker label / hint / brightness readout -->
    <style name="HudText.Small">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="HudText.Small.Dim">
        <item name="android:textColor">@color/hud_dim</item>
    </style>
    <style name="HudText.PickerLabel">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:background">@drawable/bar_button_bg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
