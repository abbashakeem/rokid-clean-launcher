<resources>
    <style name="Theme.Hud" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/hud_black</item>
        <item name="android:colorBackground">@color/hud_black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/hud_black</item>
        <item name="android:navigationBarColor">@color/hud_black</item>
        <item name="android:textColor">@color/hud_white</item>
    </style>

    <!-- Base: white with a soft shadow for readability against the real world -->
    <style name="HudText">
        <item name="android:textColor">@color/hud_white</item>
        <item name="android:shadowColor">@color/hud_shadow</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Display typeface (Rajdhani) for clock, date and weather -->
    <style name="HudText.Display">
        <item name="android:fontFamily">@font/rajdhani_medium</item>
    </style>
    <style name="HudText.Display.Clock">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="HudText.Display.DateDay">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="HudText.Display.DateNum">
        <item name="android:textSize">17sp</item>
    </style>
    <style name="HudText.Display.City">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/hud_dim</item>
    </style>
    <style name="HudText.Display.Temp">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="HudText.Display.Condition">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="HudText.Display.Feels">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/hud_dim</item>
    </style>

    <!-- Agenda rows: match Rokid's ~12sp system sans -->
    <style name="HudText.Event">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="HudText.Event.Dim">
        <item name="android:textColor">@color/hud_dim</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:background">@drawable/bar_button_bg</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
