<?xml version="1.0" encoding="utf-8"?>
<!-- One agenda row: fixed day and time columns so titles line up like Rokid's list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/row_gap">
    <TextView android:id="@+id/col_day" style="@style/HudText.Event.Dim"
        android:layout_width="@dimen/col_day" android:layout_height="wrap_content" />
    <TextView android:id="@+id/col_time" style="@style/HudText.Event"
        android:layout_width="@dimen/col_time" android:layout_height="wrap_content" />
    <TextView android:id="@+id/col_title" style="@style/HudText.Event"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
</LinearLayout>
