<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_black">

    <!-- Everything lives inside the band the waveguide actually shows -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/band"
        android:layout_width="match_parent"
        android:layout_height="@dimen/band_height"
        android:layout_marginTop="@dimen/band_top"
        android:paddingStart="@dimen/band_side"
        android:paddingEnd="@dimen/band_side">

        <!-- Date strip: "SAT 12 SEP" left, city right -->
        <TextView android:id="@+id/date_strip" style="@style/HudText.Strip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SAT 12 SEP"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/wx_city" style="@style/HudText.Strip"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Weather block, right, under the strip -->
        <TextView android:id="@+id/wx_temp" style="@style/HudText.Temp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/weather_loading"
            app:layout_constraintEnd_toStartOf="@id/wx_icon"
            app:layout_constraintTop_toBottomOf="@id/wx_city" />
        <ImageView android:id="@+id/wx_icon"
            android:layout_width="23dp" android:layout_height="23dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            app:tint="@color/hud_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/wx_temp"
            app:layout_constraintBottom_toBottomOf="@id/wx_temp" />
        <TextView android:id="@+id/wx_condition" style="@style/HudText.Condition"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_temp" />
        <TextView android:id="@+id/wx_feels" style="@style/HudText.Feels"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_condition" />

        <!-- Clock: h:mm, bottom-aligned with the weather block; AM/PM shares its baseline -->
        <TextView android:id="@+id/clock" style="@style/HudText.Clock"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="5:57"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/wx_feels" />
        <TextView android:id="@+id/ampm" style="@style/HudText.AmPm"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="PM"
            app:layout_constraintStart_toEndOf="@id/clock"
            app:layout_constraintBaseline_toBaselineOf="@id/clock" />

        <!-- Navigation card: turn info top-left, map top-right, compact clock + weather below -->
        <LinearLayout android:id="@+id/nav_card"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bar">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="top|center_horizontal">
                <LinearLayout android:layout_width="170dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginEnd="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/nav_icon"
                            android:layout_width="40dp" android:layout_height="40dp"
                            android:scaleType="fitCenter" android:contentDescription="@null"
                            android:src="@drawable/nav_straight" />
                        <TextView android:id="@+id/nav_distance" style="@style/HudText.Clock"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:textSize="30sp" android:ellipsize="none" android:text="350 m" />
                    </LinearLayout>
                    <TextView android:id="@+id/nav_road" style="@style/HudText.Condition"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:textSize="14sp" android:ellipsize="marquee" android:singleLine="true"
                        android:marqueeRepeatLimit="marquee_forever" android:text="" />
                    <TextView android:id="@+id/nav_summary" style="@style/HudText.Feels"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/nav_muted"
                            android:layout_width="12dp" android:layout_height="12dp"
                            android:src="@drawable/ic_muted" android:contentDescription="@null" android:visibility="gone" />
                        <TextView android:id="@+id/nav_muted_text" style="@style/HudText.Feels"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="voice muted" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <ImageView android:id="@+id/nav_map"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:scaleType="centerCrop" android:contentDescription="@null"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- compact date + time (left) and small weather (right) while navigating -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom" android:layout_marginBottom="6dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/nav_date" style="@style/HudText.Strip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9.5sp" android:text="SUN 13 SEP" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
                        <TextView android:id="@+id/nav_clock" style="@style/HudText.Clock"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="26sp" android:text="5:57" />
                        <TextView android:id="@+id/nav_ampm" style="@style/HudText.AmPm"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:layout_marginBottom="2dp" android:textSize="12sp" android:text="PM" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="end">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/nav_wx_temp" style="@style/HudText.Temp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:text="--°" />
                        <ImageView android:id="@+id/nav_wx_icon"
                            android:layout_width="14dp" android:layout_height="14dp"
                            android:layout_marginStart="4dp" android:contentDescription="@null"
                            app:tint="@color/hud_white" />
                    </LinearLayout>
                    <TextView android:id="@+id/nav_wx_cond" style="@style/HudText.Feels"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:text="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Agenda: rows inflated from row_event.xml -->
        <LinearLayout android:id="@+id/agenda"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:showDividers="middle"
            android:divider="@drawable/row_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_feels" />

        <!-- Status: battery bottom-left, Wi-Fi bottom-right, on the bar's centre line -->
        <LinearLayout android:id="@+id/status_left"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bar"
            app:layout_constraintBottom_toBottomOf="@id/bar">
            <com.abbas.hudlauncher.BatteryView android:id="@+id/battery_icon"
                android:layout_width="16dp" android:layout_height="8dp" />
            <TextView android:id="@+id/battery_text" style="@style/HudText.Small"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:textSize="9.5sp" android:text="100%" />
        </LinearLayout>
        <LinearLayout android:id="@+id/status_right"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/bar"
            app:layout_constraintBottom_toBottomOf="@id/bar">
            <ImageView android:id="@+id/phone_link"
                android:layout_width="11dp" android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_phone_link" android:contentDescription="@null"
                android:alpha="0.3" />
            <com.abbas.hudlauncher.WifiView android:id="@+id/wifi_icon"
                android:layout_width="15dp" android:layout_height="11dp" />
        </LinearLayout>

        <!-- Bottom bar: brightness · home · apps -->
        <LinearLayout android:id="@+id/bar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton android:id="@+id/btn_messages" style="@style/BarButton"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_messages" android:contentDescription="@string/btn_messages" />
            <ImageButton android:id="@+id/btn_brightness" style="@style/BarButton"
                android:src="@drawable/ic_brightness" android:contentDescription="@string/btn_brightness" />
            <ImageButton android:id="@+id/btn_home" style="@style/BarButton"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                android:src="@drawable/ic_home" android:contentDescription="@string/btn_home" />
            <!-- Now-playing pill: shown instead of the home button while music is active -->
            <LinearLayout android:id="@+id/music_pill"
                android:layout_width="96dp" android:layout_height="26dp"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp"
                android:background="@drawable/bar_button_bg"
                android:focusable="true" android:clickable="true" android:soundEffectsEnabled="false"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/music_state"
                        android:layout_width="10dp" android:layout_height="10dp"
                        android:src="@drawable/ic_play" android:contentDescription="@null" />
                    <TextView android:id="@+id/music_text" style="@style/HudText.Small"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:textSize="9.5sp"
                        android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true" android:text="" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="2dp"
                    android:layout_marginBottom="3dp" android:background="@drawable/brightness_track">
                    <View android:id="@+id/music_progress" android:layout_width="0dp" android:layout_height="match_parent"
                        android:background="@drawable/brightness_fill" />
                </FrameLayout>
            </LinearLayout>
            <ImageButton android:id="@+id/btn_apps" style="@style/BarButton"
                android:src="@drawable/ic_apps" android:contentDescription="@string/btn_apps" />
        </LinearLayout>

        <!-- App picker: Rokid-style horizontal carousel, centred item enlarged with its label below -->
        <LinearLayout android:id="@+id/app_picker"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hud_black"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bar">
            <LinearLayout android:id="@+id/app_rows"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clipChildren="false" />
            <TextView android:id="@+id/app_picker_title" style="@style/HudText.PickerLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="" />
            <TextView style="@style/HudText.Small.Dim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/picker_hint" />
        </LinearLayout>

        <!-- Messages panel: last phone notifications relayed by the Rokid app -->
        

        <!-- Brightness picker overlay (hidden until the left button is pressed) -->
        <LinearLayout android:id="@+id/brightness_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="@color/hud_black"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_brightness" android:contentDescription="@null" app:tint="@color/hud_white" />
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="4dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@drawable/brightness_track">
                <View android:id="@+id/brightness_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/brightness_fill" />
            </FrameLayout>
            <TextView android:id="@+id/brightness_value" style="@style/HudText.Small"
                android:layout_width="34dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="50%" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
