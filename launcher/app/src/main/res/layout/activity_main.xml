<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_black">

    <!-- Everything lives inside the band the waveguide actually shows -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/band"
        android:layout_width="match_parent"
        android:layout_height="@dimen/band_height"
        android:layout_marginTop="@dimen/band_top"
        android:paddingStart="@dimen/band_side"
        android:paddingEnd="@dimen/band_side">

        <!-- Date: WED / 31 Dec -->
        <TextView android:id="@+id/date_day" style="@style/HudText.Display.DateDay"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="WED"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/clock"
            app:layout_constraintBottom_toTopOf="@id/date_num"
            app:layout_constraintVertical_chainStyle="packed" />
        <TextView android:id="@+id/date_num" style="@style/HudText.Display.DateNum"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="31 Dec"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_day"
            app:layout_constraintBottom_toBottomOf="@id/clock" />

        <!-- Clock -->
        <TextView android:id="@+id/clock" style="@style/HudText.Display.Clock"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="12:00 PM"
            app:layout_constraintStart_toEndOf="@id/date_barrier"
            app:layout_constraintEnd_toStartOf="@id/wx_barrier"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Barriers keep the clock centred in the free space between date and weather -->
        <androidx.constraintlayout.widget.Barrier android:id="@+id/date_barrier"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:barrierDirection="end" app:constraint_referenced_ids="date_day,date_num" />
        <androidx.constraintlayout.widget.Barrier android:id="@+id/wx_barrier"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:barrierDirection="start" app:constraint_referenced_ids="wx_city,wx_temp,wx_condition,wx_feels" />

        <!-- Weather block (right) -->
        <TextView android:id="@+id/wx_city" style="@style/HudText.Display.City"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView android:id="@+id/wx_icon"
            android:layout_width="22dp" android:layout_height="22dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null"
            app:tint="@color/hud_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/wx_temp"
            app:layout_constraintBottom_toBottomOf="@id/wx_temp" />
        <TextView android:id="@+id/wx_temp" style="@style/HudText.Display.Temp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/weather_loading"
            app:layout_constraintEnd_toStartOf="@id/wx_icon"
            app:layout_constraintTop_toBottomOf="@id/wx_city" />
        <TextView android:id="@+id/wx_condition" style="@style/HudText.Display.Condition"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_temp" />
        <TextView android:id="@+id/wx_feels" style="@style/HudText.Display.Feels"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_condition" />

        <!-- Agenda: rows inflated from row_event.xml -->
        <LinearLayout android:id="@+id/agenda"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wx_feels" />

        <!-- Bottom bar: brightness · home · apps -->
        <LinearLayout android:id="@+id/bar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageButton android:id="@+id/btn_brightness" style="@style/BarButton"
                android:src="@drawable/ic_brightness" android:contentDescription="@string/btn_brightness" />
            <ImageButton android:id="@+id/btn_home" style="@style/BarButton"
                android:layout_marginStart="22dp" android:layout_marginEnd="22dp"
                android:src="@drawable/ic_home" android:contentDescription="@string/btn_home" />
            <ImageButton android:id="@+id/btn_apps" style="@style/BarButton"
                android:src="@drawable/ic_apps" android:contentDescription="@string/btn_apps" />
        </LinearLayout>

        <!-- App picker: Rokid-style horizontal carousel, centred item enlarged with its label below -->
        <LinearLayout android:id="@+id/app_picker"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hud_black"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bar">
            <LinearLayout android:id="@+id/app_rows"
                android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clipChildren="false" />
            <TextView android:id="@+id/app_picker_title" style="@style/HudText.Display"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp" android:text="" />
            <TextView style="@style/HudText.Event.Dim"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/picker_hint" />
        </LinearLayout>

        <!-- Brightness picker overlay (hidden until the left button is pressed) -->
        <LinearLayout android:id="@+id/brightness_panel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="@color/hud_black"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_brightness" android:contentDescription="@null" app:tint="@color/hud_white" />
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="4dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@drawable/brightness_track">
                <View android:id="@+id/brightness_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:background="@drawable/brightness_fill" />
            </FrameLayout>
            <TextView android:id="@+id/brightness_value" style="@style/HudText.Event"
                android:layout_width="34dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="50%" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
