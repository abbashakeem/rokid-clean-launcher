# Copy to .env for local runs. On Render, set these under the service → Environment tab.

# Shared secret the glasses send in the X-API-KEY header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# iCloud CalDAV (leave blank to disable sync; POST /update-calendar still works)
ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Exact calendar display names, comma separated
CALENDARS=Personal,Work
SYNC_INTERVAL_MIN=15
LOOKAHEAD_DAYS=7

# OpenWeatherMap (https://home.openweathermap.org/api_keys)
OWM_API_KEY=
LAT=51.5074
LON=-0.1278
UNITS=metric

# IANA timezone for formatting event times
TZ=Europe/London

# Where calendar.json is stored (ephemeral on Render free; cache rebuilds from iCloud on first request)
DATA_DIR=./data
